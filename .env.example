# DentoPoint – Environment Variables
# Copy this file to .env and fill in your Supabase project values.
# NEVER commit the .env file — it is listed in .gitignore.

# ── Supabase ────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API

# Your Supabase project URL (one per deployment region)
VITE_SUPABASE_URL=https://<project-id>.supabase.co

# Supabase anon / publishable key (safe to expose in browser)
VITE_SUPABASE_PUBLISHABLE_KEY=<your-anon-key>

# Internal project reference (used by Supabase CLI, not exposed to browser)
VITE_SUPABASE_PROJECT_ID=<project-id>

# ── Multi-Region Setup ───────────────────────────────────────────────────────
# When running a second Supabase project for a new region, create a separate
# .env file per environment (e.g. .env.sg for Singapore) and set the values
# above to the region-specific project.
#
# See AGENTS.md → "Global Scaling Checklist → Technical" for full checklist.
